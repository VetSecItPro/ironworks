# SEC-INFRA-AGENT13-003 (2026-05-09): digest-pin. Captured 2026-05-10.
FROM ubuntu:24.04@sha256:c4a8d5503dfb2a3eb8ab5f807da5bc69a85730fb49b5cfca2330194ebcc41c7b

ARG NODE_MAJOR=20
# SEC-INFRA-AGENT13-002 fix (2026-05-09): default must be a real, immutable
# version, not "latest". Release-smoke supplies the just-published tag at
# build time via --build-arg; the default is a fallback for ad-hoc runs and
# must be a known-good pinned version, not whatever happens to be tagged
# `latest` (which is TOFU-resolvable at container-start via npx).
ARG IRONWORKSAI_VERSION=0.3.1
ARG HOST_UID=10001

ENV DEBIAN_FRONTEND=noninteractive \
  IRONWORKS_HOME=/ironworks \
  IRONWORKS_OPEN_ON_LISTEN=false \
  HOST=0.0.0.0 \
  PORT=3100 \
  HOME=/home/ironworks \
  LANG=en_US.UTF-8 \
  LC_ALL=en_US.UTF-8 \
  NPM_CONFIG_UPDATE_NOTIFIER=false \
  NODE_MAJOR=${NODE_MAJOR} \
  IRONWORKSAI_VERSION=${IRONWORKSAI_VERSION}

RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates curl gnupg locales \
  && mkdir -p /etc/apt/keyrings \
  && curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key \
    | gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg \
  && echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_${NODE_MAJOR}.x nodistro main" \
    > /etc/apt/sources.list.d/nodesource.list \
  && apt-get update \
  && apt-get install -y --no-install-recommends nodejs \
  && locale-gen en_US.UTF-8 \
  && groupadd --gid 10001 ironworks \
  && useradd --create-home --shell /bin/bash --uid "${HOST_UID}" --gid 10001 ironworks \
  && mkdir -p /ironworks /home/ironworks/workspace \
  && chown -R ironworks:ironworks /ironworks /home/ironworks \
  && rm -rf /var/lib/apt/lists/*

VOLUME ["/ironworks"]
WORKDIR /home/ironworks/workspace
EXPOSE 3100
USER ironworks

CMD ["bash", "-lc", "set -euo pipefail; mkdir -p \"$IRONWORKS_HOME\"; npx --yes \"ironworksai@${IRONWORKSAI_VERSION}\" onboard --yes --data-dir \"$IRONWORKS_HOME\""]
